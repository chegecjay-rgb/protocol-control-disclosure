// SPDX-License-Identifier: MIT
pragma solidity 0.8.24;

import {Test} from "forge-std/Test.sol";
import {ProtocolSafetyModule} from "src/core/ProtocolSafetyModule.sol";
import {SafetyTypes} from "src/libraries/SafetyTypes.sol";
import {MockConstrainedProtocol} from "src/mocks/MockConstrainedProtocol.sol";
import {MockExecutionModule} from "src/mocks/MockExecutionModule.sol";
import {MockMultisigController} from "src/mocks/MockMultisigController.sol";
import {MockReserveCustodian} from "src/mocks/MockReserveCustodian.sol";
import {MockTimelockController} from "src/mocks/MockTimelockController.sol";
import {MockUnsafeProtocol} from "src/mocks/MockUnsafeProtocol.sol";

contract IntegrationExamplesTest is Test {
    function test_manifestClosureSuccessCase() external {
        (ProtocolSafetyModule module,, MockMultisigController safe,, MockConstrainedProtocol protocol) = _deployConstrainedModule();

        SafetyTypes.DisclosureSummary memory disclosure = module.disclosureSummary();
        SafetyTypes.ConstraintSummary memory constraints = module.constraintSummary();

        assertTrue(disclosure.manifestClosed);
        assertTrue(disclosure.allPowersHaveKnownControllers);
        assertEq(disclosure.unknownPrivilegeCount, 0);
        assertEq(module.findingCountByKind(SafetyTypes.DiagnosticKind.MANIFEST_CLOSURE_VIOLATION), 0);
        assertTrue(constraints.noSingleKeySensitiveControl);
        assertTrue(constraints.noZeroDelayFundsSensitiveUpgrade);
        assertTrue(module.hasTransitivePowerPath(_nodeId(address(safe)), address(protocol), SafetyTypes.PowerKind.UPGRADE));
    }

    function test_manifestClosureFailureWhenCustodianOmitted() external {
        ProtocolSafetyModule module = new ProtocolSafetyModule(
            address(this),
            "Omitted Custodian",
            1,
            keccak256("omitted-custodian"),
            "ipfs://omitted-custodian",
            "ipfs://omitted-custodian-meta",
            true
        );
        MockReserveCustodian custodian = new MockReserveCustodian();

        module.setGraphNode(_node(address(this), SafetyTypes.NodeType.OTHER, true, false, true, SafetyTypes.EvidenceStrength.SELF_DECLARED, keccak256("founder")));
        module.setGraphNode(_node(address(custodian), SafetyTypes.NodeType.CUSTODIAN, false, true, true, SafetyTypes.EvidenceStrength.ONCHAIN_DERIVED, keccak256("custodian")));

        SafetyTypes.PowerDescriptor memory powerData = _basePower(
            keccak256("custodian-move-reserves"),
            SafetyTypes.PowerKind.MOVE_RESERVES,
            address(custodian),
            address(this)
        );
        powerData.controllerType = SafetyTypes.ControllerType.EOA;
        powerData.threshold = 1;
        powerData.controllerCount = 1;
        powerData.scope = SafetyTypes.Scope.CUSTODY_POOL;
        powerData.maxImpactValue = type(uint256).max;
        powerData.scopeHash = keccak256("custodian-scope");
        powerData.notesHash = keccak256("custodian-notes");
        module.setPowerDescriptor(powerData);

        SafetyTypes.DisclosureSummary memory disclosure = module.disclosureSummary();
        assertFalse(disclosure.manifestClosed);
        assertTrue(module.hasFinding(SafetyTypes.DiagnosticKind.OMITTED_RESERVE_CUSTODIAN));
    }

    function test_unknownPrivilegedPathCausesNonCompliance() external {
        ProtocolSafetyModule module = new ProtocolSafetyModule(
            address(this),
            "Unknown Module",
            1,
            keccak256("unknown-module"),
            "ipfs://unknown-module",
            "ipfs://unknown-module-meta",
            true
        );
        MockExecutionModule hiddenModule = new MockExecutionModule();
        MockUnsafeProtocol protocol = new MockUnsafeProtocol(address(this));

        module.setComponent(
            _component(
                address(protocol),
                SafetyTypes.NodeType.PROXY,
                true,
                true,
                true,
                true,
                false,
                address(0),
                bytes32(0),
                SafetyTypes.EvidenceStrength.EXACT_VERIFIED,
                keccak256("unknown-proxy")
            )
        );

        SafetyTypes.PowerDescriptor memory powerData = _basePower(
            keccak256("hidden-delegatecall"),
            SafetyTypes.PowerKind.DELEGATECALL_EXTENSION,
            address(protocol),
            address(hiddenModule)
        );
        powerData.controllerType = SafetyTypes.ControllerType.MODULE;
        powerData.threshold = 1;
        powerData.controllerCount = 1;
        powerData.scope = SafetyTypes.Scope.MODULE_SET;
        powerData.maxImpactValue = type(uint256).max;
        powerData.scopeHash = keccak256("delegatecall-scope");
        powerData.notesHash = keccak256("delegatecall-notes");
        module.setPowerDescriptor(powerData);

        SafetyTypes.DisclosureSummary memory disclosure = module.disclosureSummary();
        assertGt(disclosure.unknownPrivilegeCount, 0);
        assertTrue(module.hasFinding(SafetyTypes.DiagnosticKind.UNKNOWN_PRIVILEGED_PATH));
        assertTrue(module.hasFinding(SafetyTypes.DiagnosticKind.UNDISCLOSED_DELEGATECALL_EXTENSION));
    }

    function test_singleKeyCriticalUpgradeFailure() external {
        (ProtocolSafetyModule module,,,) = _deployUnsafeModule();
        assertTrue(module.hasFinding(SafetyTypes.DiagnosticKind.SINGLE_EOA_SENSITIVE_CONTROL));
    }

    function test_zeroDelayCustodyUpgradeFailure() external {
        (ProtocolSafetyModule module,,,) = _deployUnsafeModule();
        assertTrue(module.hasFinding(SafetyTypes.DiagnosticKind.ZERO_DELAY_FUNDS_SENSITIVE_UPGRADE));
    }

    function test_disclosedButDangerousVsDisclosedAndConstrained() external {
        (ProtocolSafetyModule unsafeModule,,,) = _deployUnsafeModule();
        (ProtocolSafetyModule constrainedModule,, MockMultisigController safe,, MockConstrainedProtocol protocol) = _deployConstrainedModule();

        SafetyTypes.DisclosureSummary memory unsafeDisclosure = unsafeModule.disclosureSummary();
        SafetyTypes.DisclosureSummary memory constrainedDisclosure = constrainedModule.disclosureSummary();
        SafetyTypes.ConstraintSummary memory unsafeConstraints = unsafeModule.constraintSummary();
        SafetyTypes.ConstraintSummary memory constrainedConstraints = constrainedModule.constraintSummary();

        assertTrue(unsafeDisclosure.manifestClosed);
        assertTrue(constrainedDisclosure.manifestClosed);
        assertFalse(unsafeConstraints.noSingleKeySensitiveControl);
        assertFalse(unsafeConstraints.noZeroDelayFundsSensitiveUpgrade);
        assertTrue(constrainedConstraints.noSingleKeySensitiveControl);
        assertTrue(constrainedConstraints.noZeroDelayFundsSensitiveUpgrade);
        assertTrue(constrainedConstraints.sensitivePowersDelayed);
        assertTrue(moduleHasControlPath(constrainedModule, _nodeId(address(safe)), _nodeId(address(protocol))));
    }

    function test_transitivePrivilegePathModeling() external {
        (ProtocolSafetyModule module,, MockMultisigController safe, MockTimelockController timelock, MockConstrainedProtocol protocol) = _deployConstrainedModule();

        assertTrue(moduleHasControlPath(module, _nodeId(address(safe)), _nodeId(address(timelock))));
        assertTrue(module.hasTransitivePowerPath(_nodeId(address(safe)), address(protocol), SafetyTypes.PowerKind.UPGRADE));
        assertTrue(module.hasTransitivePowerPath(_nodeId(address(safe)), address(protocol), SafetyTypes.PowerKind.MOVE_RESERVES));
    }

    function test_applicableAuditEvidenceIsSeparateFromStructuralProfile() external {
        (ProtocolSafetyModule module,,,) = _deployUnsafeModule();
        _attachMatchingAudit(module, keccak256("unsafe"), address(0xBEEF));

        SafetyTypes.ConstraintSummary memory constraints = module.constraintSummary();
        SafetyTypes.AuditEvidenceSummary memory auditSummary = module.auditEvidenceSummary();

        assertFalse(constraints.noSingleKeySensitiveControl);
        assertFalse(constraints.noZeroDelayFundsSensitiveUpgrade);
        assertTrue(auditSummary.auditEvidencePresent);
        assertTrue(auditSummary.currentAuditExactMatch);
        assertTrue(module.hasFinding(SafetyTypes.DiagnosticKind.SINGLE_EOA_SENSITIVE_CONTROL));
        assertFalse(module.hasAuditIssue(SafetyTypes.AuditIssueKind.NO_AUDIT_EVIDENCE));
    }

    function test_constrainedProtocolCanExposeCurrentAuditContext() external {
        (ProtocolSafetyModule module,, MockMultisigController safe,, MockConstrainedProtocol protocol) = _deployConstrainedModule();
        _attachMatchingAudit(module, keccak256("constrained"), address(protocol));

        SafetyTypes.ConstraintSummary memory constraints = module.constraintSummary();
        SafetyTypes.AuditEvidenceSummary memory auditSummary = module.auditEvidenceSummary();

        assertTrue(constraints.noSingleKeySensitiveControl);
        assertTrue(constraints.sensitivePowersDelayed);
        assertTrue(auditSummary.auditEvidencePresent);
        assertTrue(auditSummary.currentAuditApplies);
        assertTrue(auditSummary.currentAuditExactMatch);
        assertFalse(auditSummary.userInterpretationRisk);
        assertTrue(module.hasTransitivePowerPath(_nodeId(address(safe)), address(protocol), SafetyTypes.PowerKind.UPGRADE));
    }

    function _deployUnsafeModule()
        internal
        returns (ProtocolSafetyModule module, MockUnsafeProtocol protocol, address founder, address implementation)
    {
        founder = address(this);
        protocol = new MockUnsafeProtocol(founder);
        implementation = address(new MockExecutionModule());

        module = new ProtocolSafetyModule(
            founder,
            "Unsafe Single Key",
            1,
            keccak256("unsafe"),
            "ipfs://unsafe-manifest",
            "ipfs://unsafe-meta",
            true
        );

        module.setGraphNode(_node(founder, SafetyTypes.NodeType.OTHER, true, false, true, SafetyTypes.EvidenceStrength.SELF_DECLARED, keccak256("founder-node")));
        module.setComponent(_component(address(protocol), SafetyTypes.NodeType.PROXY, true, true, true, true, true, implementation, _nodeId(founder), SafetyTypes.EvidenceStrength.EXACT_VERIFIED, keccak256("unsafe-proxy")));
        module.setComponent(_component(implementation, SafetyTypes.NodeType.IMPLEMENTATION, true, true, false, true, false, address(0), bytes32(0), SafetyTypes.EvidenceStrength.EXACT_VERIFIED, keccak256("unsafe-impl")));

        SafetyTypes.PowerDescriptor memory upgradePower = _basePower(keccak256("unsafe-upgrade"), SafetyTypes.PowerKind.UPGRADE, address(protocol), founder);
        upgradePower.controllerType = SafetyTypes.ControllerType.EOA;
        upgradePower.threshold = 1;
        upgradePower.controllerCount = 1;
        upgradePower.scope = SafetyTypes.Scope.CONTRACT;
        upgradePower.revocable = true;
        upgradePower.scopeHash = keccak256("unsafe-upgrade-scope");
        upgradePower.notesHash = keccak256("unsafe-upgrade-notes");
        module.setPowerDescriptor(upgradePower);

        SafetyTypes.PowerDescriptor memory sweepPower = _basePower(keccak256("unsafe-sweep"), SafetyTypes.PowerKind.SWEEP_FUNDS, address(protocol), founder);
        sweepPower.controllerType = SafetyTypes.ControllerType.EOA;
        sweepPower.threshold = 1;
        sweepPower.controllerCount = 1;
        sweepPower.scope = SafetyTypes.Scope.CUSTODY_POOL;
        sweepPower.maxImpactValue = type(uint256).max;
        sweepPower.revocable = true;
        sweepPower.scopeHash = keccak256("unsafe-sweep-scope");
        sweepPower.notesHash = keccak256("unsafe-sweep-notes");
        module.setPowerDescriptor(sweepPower);

        module.setGraphEdge(_edge(keccak256("unsafe-founder-upgrade-edge"), SafetyTypes.EdgeKind.CAN_UPGRADE, SafetyTypes.PowerKind.UPGRADE, founder, address(protocol), true, false, false, false, SafetyTypes.EvidenceStrength.SELF_DECLARED, keccak256("unsafe-upgrade-edge")));
        module.setGraphEdge(_edge(keccak256("unsafe-founder-sweep-edge"), SafetyTypes.EdgeKind.CAN_SWEEP_FUNDS, SafetyTypes.PowerKind.SWEEP_FUNDS, founder, address(protocol), true, false, false, true, SafetyTypes.EvidenceStrength.SELF_DECLARED, keccak256("unsafe-sweep-edge")));
    }

    function _deployConstrainedModule()
        internal
        returns (
            ProtocolSafetyModule module,
            address implementation,
            MockMultisigController safe,
            MockTimelockController timelock,
            MockConstrainedProtocol protocol
        )
    {
        address[] memory signers = new address[](5);
        signers[0] = address(0x11);
        signers[1] = address(0x12);
        signers[2] = address(0x13);
        signers[3] = address(0x14);
        signers[4] = address(0x15);

        safe = new MockMultisigController(3, signers);
        timelock = new MockTimelockController(address(safe), 72 hours);
        protocol = new MockConstrainedProtocol(address(timelock), address(safe), address(timelock));
        implementation = address(new MockExecutionModule());

        module = new ProtocolSafetyModule(
            address(this),
            "Constrained Multisig",
            1,
            keccak256("constrained"),
            "ipfs://constrained-manifest",
            "ipfs://constrained-meta",
            true
        );

        module.setGraphNode(_node(address(safe), SafetyTypes.NodeType.MULTISIG, true, false, true, SafetyTypes.EvidenceStrength.ONCHAIN_DERIVED, keccak256("safe")));
        module.setGraphNode(_node(address(timelock), SafetyTypes.NodeType.TIMELOCK, true, false, true, SafetyTypes.EvidenceStrength.ONCHAIN_DERIVED, keccak256("timelock")));
        module.setComponent(_component(address(protocol), SafetyTypes.NodeType.PROXY, true, true, true, true, true, implementation, _nodeId(address(timelock)), SafetyTypes.EvidenceStrength.EXACT_VERIFIED, keccak256("constrained-proxy")));
        module.setComponent(_component(implementation, SafetyTypes.NodeType.IMPLEMENTATION, true, true, false, true, false, address(0), bytes32(0), SafetyTypes.EvidenceStrength.EXACT_VERIFIED, keccak256("constrained-impl")));

        SafetyTypes.PowerDescriptor memory upgradePower = _basePower(keccak256("constrained-upgrade"), SafetyTypes.PowerKind.UPGRADE, address(protocol), address(safe));
        upgradePower.controllerType = SafetyTypes.ControllerType.MULTISIG;
        upgradePower.threshold = 3;
        upgradePower.controllerCount = 5;
        upgradePower.executionDelaySeconds = 72 hours;
        upgradePower.scope = SafetyTypes.Scope.CONTRACT;
        upgradePower.revocable = true;
        upgradePower.scopeHash = keccak256("constrained-upgrade-scope");
        upgradePower.notesHash = keccak256("constrained-upgrade-notes");
        module.setPowerDescriptor(upgradePower);

        SafetyTypes.PowerDescriptor memory reservesPower = _basePower(keccak256("constrained-reserves"), SafetyTypes.PowerKind.MOVE_RESERVES, address(protocol), address(safe));
        reservesPower.controllerType = SafetyTypes.ControllerType.MULTISIG;
        reservesPower.threshold = 3;
        reservesPower.controllerCount = 5;
        reservesPower.executionDelaySeconds = 7 days;
        reservesPower.scope = SafetyTypes.Scope.CUSTODY_POOL;
        reservesPower.maxImpactValue = 5_000_000e18;
        reservesPower.rateLimit = 1_000_000e18;
        reservesPower.rateLimitWindowSeconds = 1 days;
        reservesPower.revocable = true;
        reservesPower.scopeHash = keccak256("constrained-reserves-scope");
        reservesPower.notesHash = keccak256("constrained-reserves-notes");
        module.setPowerDescriptor(reservesPower);

        module.setGraphEdge(_edge(keccak256("safe-controls-timelock"), SafetyTypes.EdgeKind.CONTROLS, SafetyTypes.PowerKind.UPGRADE, address(safe), address(timelock), true, false, false, false, SafetyTypes.EvidenceStrength.ONCHAIN_DERIVED, keccak256("safe-controls-timelock")));
        module.setGraphEdge(_edge(keccak256("timelock-upgrades-proxy"), SafetyTypes.EdgeKind.CAN_UPGRADE, SafetyTypes.PowerKind.UPGRADE, address(timelock), address(protocol), true, false, false, false, SafetyTypes.EvidenceStrength.ONCHAIN_DERIVED, keccak256("timelock-upgrades-proxy")));
        module.setGraphEdge(_edge(keccak256("timelock-moves-reserves"), SafetyTypes.EdgeKind.CAN_MOVE_RESERVES, SafetyTypes.PowerKind.MOVE_RESERVES, address(timelock), address(protocol), true, false, false, true, SafetyTypes.EvidenceStrength.ONCHAIN_DERIVED, keccak256("timelock-moves-reserves")));
    }

    function _attachMatchingAudit(
        ProtocolSafetyModule module,
        bytes32 manifestHash,
        address subject
    ) internal {
        bytes32 auditId = keccak256(abi.encodePacked(manifestHash, subject));
        bytes32 findingId = keccak256(abi.encodePacked(auditId, uint256(1)));

        SafetyTypes.AuditRecord memory auditData;
        auditData.auditId = auditId;
        auditData.auditorName = "Independent Auditor";
        auditData.reportURI = "ipfs://audit-report";
        auditData.reportHash = keccak256("report");
        auditData.reportMetadataHash = keccak256("report-meta");
        auditData.coveredManifestHash = manifestHash;
        auditData.coveredBuildHash = keccak256("build");
        auditData.coveredCommitHash = keccak256("commit");
        auditData.coveredDeploymentHash = keccak256("deployment");
        auditData.issuedAt = 1_700_000_000;
        auditData.scope = SafetyTypes.AuditScope.FULL;
        auditData.publicReport = true;
        auditData.coversPrivilegeGraph = true;
        auditData.coversProxyUpgradePaths = true;
        auditData.coversAdminRoles = true;
        auditData.coversModules = true;
        auditData.coversControlPaths = true;
        auditData.coversOracleConfig = true;
        auditData.coversRuntimeConfig = true;
        auditData.notesHash = keccak256("audit-notes");
        module.setAuditRecord(auditData);

        SafetyTypes.AuditContext memory applicability;
        applicability.auditId = auditId;
        applicability.status = SafetyTypes.AuditContextStatus.MATCHES_LIVE_DEPLOYMENT;
        applicability.liveMatchesManifest = true;
        applicability.liveMatchesBuild = true;
        applicability.liveMatchesDeployment = true;
        applicability.liveMatchesRuntimeConfig = true;
        applicability.liveMatchesRoleConfig = true;
        applicability.liveMatchesModules = true;
        applicability.liveMatchesProxyTopology = true;
        applicability.liveMatchesOracleConfig = true;
        applicability.liveMatchesControllers = true;
        applicability.notesHash = keccak256("applicability");
        module.setAuditContext(applicability);

        SafetyTypes.AuditFindingRecord memory findingData;
        findingData.findingId = findingId;
        findingData.auditId = auditId;
        findingData.status = SafetyTypes.AuditFindingStatus.RESOLVED;
        findingData.privilegeRelated = true;
        findingData.affectsUserFunds = false;
        findingData.subjectId = _nodeId(subject);
        findingData.powerId = keccak256("resolved-finding");
        findingData.titleHash = keccak256("resolved-title");
        findingData.notesHash = keccak256("resolved-notes");
        module.setAuditFinding(findingData);
    }

    function _basePower(
        bytes32 powerId,
        SafetyTypes.PowerKind powerKind,
        address target,
        address controller
    ) internal pure returns (SafetyTypes.PowerDescriptor memory powerData) {
        powerData.powerId = powerId;
        powerData.powerKind = powerKind;
        powerData.enabled = true;
        powerData.target = target;
        powerData.targetNodeId = _nodeId(target);
        powerData.controllerNodeId = _nodeId(controller);
    }

    function _component(
        address component,
        SafetyTypes.NodeType nodeType,
        bool inManifest,
        bool _declaredReviewSensitive,
        bool _declaredFundsSensitive,
        bool _declaredExactVerified,
        bool upgradeable,
        address implementation,
        bytes32 adminNodeId,
        SafetyTypes.EvidenceStrength _evidenceStrength,
        bytes32 metadataHash
    ) internal pure returns (SafetyTypes.Component memory) {

        return SafetyTypes.Component({
            component: component,
            nodeId: _nodeId(component),
            nodeType: nodeType,
            inManifest: inManifest,
upgradeable: upgradeable,
            implementation: implementation,
            adminNodeId: adminNodeId,
metadataHash: metadataHash
        });
    }

    function _node(
        address nodeAddress,
        SafetyTypes.NodeType nodeType,
        bool inManifest,
        bool _declaredReviewSensitive,
        bool declaredAuthority,
        SafetyTypes.EvidenceStrength _evidenceStrength,
        bytes32 metadataHash
    ) internal pure returns (SafetyTypes.GraphNode memory) {

        return SafetyTypes.GraphNode({
            nodeId: _nodeId(nodeAddress),
            nodeType: nodeType,
            nodeAddress: nodeAddress,
            inManifest: inManifest,
metadataHash: metadataHash
        });
    }

    function _edge(
        bytes32 edgeId,
        SafetyTypes.EdgeKind edgeKind,
        SafetyTypes.PowerKind powerKind,
        address from,
        address to,
        bool direct,
        bool legacyHelperFlag,
        bool declaredCanBypassDelay,
        bool declaredTouchesUserFunds,
        SafetyTypes.EvidenceStrength _evidenceStrength,
        bytes32 notesHash
    ) internal pure returns (SafetyTypes.GraphEdge memory edgeData) {

        edgeData.edgeId = edgeId;
        edgeData.edgeKind = edgeKind;
        edgeData.powerKind = powerKind;
        edgeData.fromNodeId = _nodeId(from);
        edgeData.toNodeId = _nodeId(to);
        edgeData.direct = direct;
        edgeData.notesHash = notesHash;
    }

    function _nodeId(address value) internal pure returns (bytes32) {
        return bytes32(uint256(uint160(value)));
    }

    function moduleHasControlPath(
        ProtocolSafetyModule module,
        bytes32 fromNodeId,
        bytes32 toNodeId
    ) internal view returns (bool) {
        return module.hasTransitiveControlPath(fromNodeId, toNodeId);
    }
}
